{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Indian Legal AI",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/streamlit_app.py",
        "--server.headless=true",
        "--server.address=127.0.0.1",
        "--server.port=8501"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}